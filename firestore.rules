rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validUsername(name) {
      return name is string
        && name.size() >= 3
        && name.size() <= 20
        && name.matches('^[a-z0-9._-]+$');
    }

    function validTemplate(t) {
      return t in ['classic', 'coffee', 'canvas', 'retro', 'midnight'];
    }

    function validFont(f) {
      return f in ['handwriting', 'cozy', 'animated'];
    }

    match /messages/{messageId} {
      // Public create to support anonymous portal sending.
      allow create: if request.resource.data.keys().hasOnly([
          'toUsername',
          'message_text',
          'optional_signature',
          'created_at',
          'is_read',
          'template',
          'font'
        ])
        && validUsername(request.resource.data.toUsername)
        && request.resource.data.message_text is string
        && request.resource.data.message_text.size() > 0
        && request.resource.data.message_text.size() <= 500
        && (
          request.resource.data.optional_signature == null
          || (
            request.resource.data.optional_signature is string
            && request.resource.data.optional_signature.size() <= 60
          )
        )
        && request.resource.data.created_at is timestamp
        && request.resource.data.is_read == false
        && validTemplate(request.resource.data.template)
        && validFont(request.resource.data.font);

      allow read, update: if signedIn();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if true;

      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username', 'created_at'])
        && validUsername(request.resource.data.username)
        && request.resource.data.created_at is timestamp;

      allow delete: if false;
    }
  }
}
